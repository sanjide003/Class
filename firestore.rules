rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // BUILD MODE: no authentication is used yet. This temporary rule prevents
    // the Database Error shown while the Admin/Teacher/Student pages are built.
    // Before public use, replace it with login-based role rules.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
