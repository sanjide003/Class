rules_version = '2';

// This app intentionally has no sign-in experience. Firestore cannot identify
// an administrator, teacher, or student without authentication, so these rules
// provide open access only to the application's dedicated data namespace.
// They also reject unknown collections and malformed student documents.
service cloud.firestore {
  match /databases/{database}/documents {
    function isText(value, maximumLength) {
      return value is string && value.size() <= maximumLength;
    }

    match /madrasa/public/data/config/{documentId} {
      allow read: if true;
      allow create, update: if request.resource.data.size() <= 25;
      allow delete: if true;
    }

    match /madrasa/public/data/students/{studentId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['classId', 'name', 'rollNo'])
        && request.resource.data.classId is string
        && isText(request.resource.data.classId, 100)
        && isText(request.resource.data.name, 120)
        && request.resource.data.rollNo is int
        && request.resource.data.rollNo > 0
        && request.resource.data.rollNo <= 100000;
      allow delete: if true;
    }

    match /madrasa/public/data/attendance/{documentId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['classId', 'date', 'records'])
        && isText(request.resource.data.classId, 100)
        && request.resource.data.date is string
        && request.resource.data.records is map;
      allow delete: if true;
    }

    match /madrasa/public/data/{collectionId}/{documentId} {
      allow read: if collectionId in ['task_evaluations', 'daily_tracking', 'syllabus_tracking', 'announcements'];
      allow create, update: if collectionId in ['task_evaluations', 'daily_tracking', 'syllabus_tracking', 'announcements']
        && request.resource.data.size() <= 25;
      allow delete: if collectionId in ['task_evaluations', 'daily_tracking', 'syllabus_tracking', 'announcements'];
    }
  }
}
